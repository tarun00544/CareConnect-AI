# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/careconnect_ai

# Auth
JWT_SECRET=changeme_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay (TEST MODE ONLY)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# AI Service
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# Doctor verification policy: `required` = only VERIFIED doctors are listed/bookable (recommended),
# `optional` = verification is informational only (demos)
DOCTOR_VERIFICATION_POLICY=required

# Uploads
MAX_UPLOAD_MB=10

# Video (placeholder provider e.g. Twilio/Daily/Agora)
VIDEO_PROVIDER_API_KEY=your_video_provider_key
VIDEO_PROVIDER_API_SECRET=your_video_provider_secret
